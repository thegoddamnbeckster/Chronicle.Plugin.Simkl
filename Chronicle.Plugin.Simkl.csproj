<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Chronicle.Plugin.Simkl</RootNamespace>
    <AssemblyName>Chronicle.Plugin.Simkl</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Michael Beck</Authors>
    <Description>Chronicle import plugin for Simkl — imports watch history, ratings and watchlist via the Simkl API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Chronicle\src\Chronicle.Plugins\Chronicle.Plugins.csproj"
      Private="false"
      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.*" />
    <PackageReference Include="System.Text.Json"          Version="9.0.*" />
    <!--
      Serilog is loaded by the Chronicle host, not bundled here (ExcludeAssets=runtime).
      Pinned to the EXACT version Chronicle.API itself references (via Serilog.AspNetCore
      10.0.0) rather than a floating range. Confirmed directly (2026-08-21) that "4.*"
      resolves to whatever the latest published patch happens to be at build time (4.4.0),
      which throws FileNotFoundException at runtime the moment it doesn't byte for byte
      match the 4.3.0 the host actually has loaded. Bump this only when Chronicle.API's
      own Serilog version changes.
    -->
    <PackageReference Include="Serilog" Version="4.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The test project lives inside this repo; keep its sources out of the plugin assembly, and
       let it reach internal test seams (e.g. SimklMetadataProvider.CrossRefYearContradicts). -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <InternalsVisibleTo Include="Chronicle.Plugin.Simkl.Tests" />
  </ItemGroup>

</Project>
